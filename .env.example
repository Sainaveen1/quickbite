# Copy to .env (never commit .env). Use YOUR OWN personal keys/accounts only.
POSTGRES_USER=quickbite
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=quickbite
DATABASE_URL=postgres://quickbite:change-me-locally@localhost:5432/quickbite
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:19092
API_PORT=3000

# Production (VM) only
API_DOMAIN=your-subdomain.duckdns.org
DUCKDNS_SUBDOMAIN=your-subdomain
DUCKDNS_TOKEN=
GHCR_OWNER=your-github-username

